<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.gitub.hyscript7.drony.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Výrobní Linka Dronů 2000">
         <font>
            <Font size="17.0" />
         </font></Label>
      <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn prefWidth="75.0" text="Objekt" fx:id="materialColumn" />
          <TableColumn prefWidth="75.0" text="Počet" fx:id="amountColumn" />
        </columns>
      </TableView>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onStartButtonClick" text="Start" />
            <Button mnemonicParsing="false" onAction="#onStopButtonClick" text="Stop" />
             <Button mnemonicParsing="false" onAction="#onPauseButtonClick" fx:id="pauseButton" text="Pause" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </children>
</VBox>
